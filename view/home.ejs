<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Toko Buku</title>
    <style>
        /* --- Reset & Base Styles --- */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            padding: 40px 20px;
        }

        /* --- Container Utama (Kartu Putih) --- */
        .container {
            max-width: 1000px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 30px 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        /* --- Header (Sambutan & Logout) --- */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .header h1 {
            font-size: 24px;
            color: #2c3e50;
        }
        .header h1 span {
            color: #3498db;
        }
        .btn-logout {
            background-color: #e74c3c;
            color: white;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            transition: background-color 0.3s ease;
        }
        .btn-logout:hover {
            background-color: #c0392b;
        }

        /* --- Tabel Modern --- */
        h2 {
            font-size: 20px;
            color: #2c3e50;
            margin-bottom: 15px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }
        th {
            background-color: #2c3e50;
            color: #ffffff;
            text-align: left;
            padding: 15px;
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        th:first-child { border-top-left-radius: 8px; }
        th:last-child { border-top-right-radius: 8px; }

        td {
            padding: 15px;
            border-bottom: 1px solid #eee;
            font-size: 15px;
            vertical-align: middle;
        }
        
        /* Zebra striping (baris selang-seling) */
        tbody tr:nth-child(even) {
            background-color: #f9fbfb;
        }
        tbody tr:hover {
            background-color: #f1f5f9;
            transition: background-color 0.2s ease;
        }

        /* --- Form & Tombol di dalam Tabel --- */
        .action-form {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        input[type="number"] {
            width: 60px;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
        }
        input[type="number"]:focus {
            border-color: #3498db;
        }
        .btn-add {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: background-color 0.3s ease;
        }
        .btn-add:hover {
            background-color: #27ae60;
        }

        /* --- Indikator Stok Habis --- */
        .habis {
            color: #e74c3c;
            font-weight: 700;
            font-size: 14px;
            background-color: #fadbd8;
            padding: 6px 12px;
            border-radius: 4px;
            display: inline-block;
        }

        /* --- Tombol Lanjut ke Payment --- */
        .payment-container {
            text-align: right;
            margin-top: 20px;
        }
        .btn-payment {
            display: inline-block;
            background-color: #3498db;
            color: white;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 16px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(52, 152, 219, 0.2);
        }
        .btn-payment:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
            box-shadow: 0 6px 8px rgba(52, 152, 219, 0.3);
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>Selamat Datang, <span><%= user.name %></span>! 👋</h1>
            <a href="/logout" class="btn-logout">Logout</a>
        </div>
        
        <!-- Konten Utama -->
        <h2>Daftar Buku</h2>
        <table>
            <thead>
                <tr>
                    <th>Judul</th>
                    <th>Penulis</th>
                    <th>Harga</th>
                    <th>Stok</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% books.forEach(book => { %>
                    <tr>
                        <td><strong><%= book.title %></strong></td>
                        <td><%= book.author %></td>
                        <td>Rp <%= book.price.toLocaleString('id-ID') %></td>
                        <td><%= book.amount %></td>
                        <td>
                            <% if (book.amount > 0) { %>
                                <form action="/cart" method="POST" class="action-form">
                                    <input type="hidden" name="bookId" value="<%= book.id %>">
                                    <input type="number" name="qty" min="1" max="<%= book.amount %>" value="1">
                                    <button type="submit" class="btn-add">Tambah</button>
                                </form>
                            <% } else { %>
                                <span class="habis">Stok Habis</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        
        <!-- Tombol Payment -->
        <div class="payment-container">
            <a href="/payment" class="btn-payment">🛒 Lanjut ke Halaman Payment</a>
        </div>
    </div>
</body>
</html>