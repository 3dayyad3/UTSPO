<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Home - Toko Buku</title>
    <style>
        body { font-family: sans-serif; padding: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .habis { color: red; font-weight: bold; }
    </style>
</head>
<body>
    <h1>Selamat Datang, <%= user.name %>!</h1>
    <a href="/logout" style="color: red;">Logout</a>
    
    <h2>Daftar Buku</h2>
    <table>
        <tr>
            <th>Judul</th>
            <th>Penulis</th>
            <th>Harga</th>
            <th>Stok</th>
            <th>Aksi</th>
        </tr>
        <% books.forEach(book => { %>
            <tr>
                <td><%= book.title %></td>
                <td><%= book.author %></td>
                <td>Rp <%= book.price %></td>
                <td><%= book.amount %></td>
                <td>
                    <% if (book.amount > 0) { %>
                        <!-- Form ini belum berfungsi, kita buat logikanya nanti -->
                        <form action="/cart" method="POST">
                            <input type="hidden" name="bookId" value="<%= book.id %>">
                            <input type="number" name="qty" min="1" max="<%= book.amount %>" value="1" style="width: 50px;">
                            <button type="submit">Tambah ke Keranjang</button>
                        </form>
                    <% } else { %>
                        <span class="habis">Stok Habis</span>
                    <% } %>
                </td>
            </tr>
        <% }) %>
    </table>
    <br><br>
    <a href="/payment">🛒 Lanjut ke Halaman Payment</a>
</body>
</html>